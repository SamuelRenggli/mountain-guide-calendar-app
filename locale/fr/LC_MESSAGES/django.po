msgid "Deine Tour am {start} wurde abgesagt"
msgstr "Ta course du {start} est annulée"

#, python-brace-format
msgid ""
"Hallo {guest}\n"
"\n"
"{guide} musste die Tour leider absagen. Für dich entstehen keine Kosten.\n"
"\n"
"{summary}\n"
"{guide_note}\n"
"Bei Fragen: {guide_email}"
msgstr ""
"Bonjour {guest}\n"
"\n"
"{guide} a malheureusement dû annuler la course. Cela ne te coûte rien.\n"
"\n"
"{summary}\n"
"{guide_note}\n"
"Questions : {guide_email}"

#, python-brace-format
msgid "Deine Buchung bei {guide} wurde geändert"
msgstr "Ta réservation auprès de {guide} a été modifiée"

#, python-brace-format
msgid ""
"Hallo {guest}\n"
"\n"
"{guide} hat deine Buchung angepasst:\n"
"\n"
"{changes}\n"
"\n"
"Neu:\n"
"{summary}\n"
"{guide_note}\n"
"Passt etwas nicht? Melde dich bei {guide_email}.\n"
"{guest_link}"
msgstr ""
"Bonjour {guest}\n"
"\n"
"{guide} a adapté ta réservation :\n"
"\n"
"{changes}\n"
"\n"
"Nouveau :\n"
"{summary}\n"
"{guide_note}\n"
"Quelque chose ne va pas ? Écris à {guide_email}.\n"
"{guest_link}"

#, python-brace-format
msgid "Ersatzdatum für {tour}"
msgstr "Date de remplacement pour {tour}"

#, python-brace-format
msgid ""
"Hallo {guest}\n"
"\n"
"{guide} muss die Tour wegen Wetter oder Verhältnissen verschieben und "
"schlägt ein Ersatzdatum vor:\n"
"\n"
"{summary}\n"
"{guide_note}{costs_note}\n"
"Bitte sag bis {deadline} zu oder ab. Wenn das Datum nicht passt oder du "
"nicht antwortest, wird die Buchung kostenlos storniert{refund_note}.\n"
"{guest_link}"
msgstr ""
"Bonjour {guest}\n"
"\n"
"{guide} doit déplacer la course en raison de la météo ou des conditions et "
"propose une date de remplacement :\n"
"\n"
"{summary}\n"
"{guide_note}{costs_note}\n"
"Merci d’accepter ou de refuser d’ici le {deadline}. Si la date ne convient "
"pas ou si tu ne réponds pas, la réservation est annulée "
"gratuitement{refund_note}.\n"
"{guest_link}"

msgid "Ersatzdatum angenommen"
msgstr "Date de remplacement acceptée"

#, python-brace-format
msgid ""
"Hallo {guide}\n"
"\n"
"{guest} hat das Ersatzdatum angenommen:\n"
"\n"
"{summary}\n"
"\n"
"{guide_link}"
msgstr ""
"Bonjour {guide}\n"
"\n"
"{guest} a accepté la date de remplacement :\n"
"\n"
"{summary}\n"
"\n"
"{guide_link}"

msgid "Ersatzdatum abgelehnt – Buchung storniert"
msgstr "Date de remplacement refusée – réservation annulée"

#, python-brace-format
msgid ""
"Hallo {guide}\n"
"\n"
"{guest} hat das Ersatzdatum abgelehnt oder nicht rechtzeitig geantwortet. "
"Die Buchung ist storniert.\n"
"\n"
"{summary}\n"
"\n"
"{guide_link}"
msgstr ""
"Bonjour {guide}\n"
"\n"
"{guest} a refusé la date de remplacement ou n’a pas répondu à temps. La "
"réservation est annulée.\n"
"\n"
"{summary}\n"
"\n"
"{guide_link}"

#, python-brace-format
msgid "Deine Buchung bei {guide} ist storniert"
msgstr "Ta réservation auprès de {guide} est annulée"

#, python-brace-format
msgid ""
"Hallo {guest}\n"
"\n"
"Das Ersatzdatum hat nicht gepasst, deine Buchung ist storniert."
"{refund_note}\n"
"\n"
"{summary}\n"
"\n"
"{guest_link}"
msgstr ""
"Bonjour {guest}\n"
"\n"
"La date de remplacement ne convenait pas, ta réservation est annulée."
"{refund_note}\n"
"\n"
"{summary}\n"
"\n"
"{guest_link}"

