#, python-brace-format
msgid "Deine Anfrage bei {guide} ist abgelaufen"
msgstr "Ta demande auprès de {guide} a expiré"

#, python-brace-format
msgid ""
"Hallo {guest}\n"
"\n"
"Die Frist ist abgelaufen, die Buchung wurde nicht abgeschlossen.\n"
"\n"
"{summary}"
msgstr ""
"Bonjour {guest}\n"
"\n"
"Le délai est écoulé, la réservation n’a pas abouti.\n"
"\n"
"{summary}"

msgid "Buchung abgelaufen"
msgstr "Réservation expirée"

#, python-brace-format
msgid ""
"Hallo {guide}\n"
"\n"
"Diese Buchung ist abgelaufen, die Tage sind wieder frei.\n"
"\n"
"{summary}\n"
"Gast: {guest}\n"
"\n"
"{guide_link}"
msgstr ""
