msgstr "libre – cliquer sur le jour"

msgid "Angebot – anklicken zum Buchen"
msgstr "offre – cliquer pour réserver"

msgid "Richtpreis Bergführer"
msgstr "Prix indicatif du guide"

msgid "für eine eigene Tour"
msgstr "pour ta propre course"

