"\n"
"Cette réservation a expiré, les jours sont à nouveau libres.\n"
"\n"
"{summary}\n"
"Client : {guest}\n"
"\n"
"{guide_link}"

#, python-brace-format
msgid "Anmeldung bestätigt: {tour} am {start}"
msgstr "Inscription confirmée : {tour} le {start}"

#, python-brace-format
msgid ""
"Hallo {guest}\n"
"\n"
"Du bist angemeldet – vielen Dank!\n"
"\n"
