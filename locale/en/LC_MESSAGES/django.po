#, python-format
msgid ""
"Ich akzeptiere die <a href=\"%(terms_url)s\" target=\"_blank\" "
"rel=\"noopener\">Bedingungen</a> (inkl. Storno) und habe die <a "
"href=\"%(privacy_url)s\" target=\"_blank\" "
"rel=\"noopener\">Datenschutzerklärung</a> gelesen."
msgstr ""
"I accept the <a href=\"%(terms_url)s\" target=\"_blank\" "
"rel=\"noopener\">terms</a> (including cancellation) and have read the <a "
"href=\"%(privacy_url)s\" target=\"_blank\" rel=\"noopener\">privacy "
"policy</a>."

msgid ""
"Die Anmeldung ist verbindlich. Du bezahlst jetzt mit Karte oder TWINT; die "
"Plätze sind reserviert, sobald die Zahlung durch ist."
msgstr ""
"The sign-up is binding. You pay now by card or TWINT; the seats are yours "
"once the payment goes through."

msgid "Weiter zur Zahlung"
msgstr "Continue to payment"

msgid "Ausgebucht – auf die Warteliste"
