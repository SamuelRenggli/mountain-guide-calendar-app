# Production config for Cloud Run. Copy to .env.cloudrun (never committed), fill in,
# then upload with: bash deploy/push-config.sh
SECRET_KEY=
DEBUG=false
SITE_URL=https://tourchef-<project-number>.europe-west6.run.app
ALLOWED_HOSTS=tourchef-<project-number>.europe-west6.run.app
# Cloud Run's front end adds one X-Forwarded-For entry
NUM_PROXIES=1
ADMIN_URL=verwaltung-<random>/
GUIDE_SIGNUP_CODE=
ADMIN_EMAILS=

# Neon: Dashboard -> Connect -> connection string (keep ?sslmode=require)
DATABASE_URL=

# SMTP (e.g. Brevo: smtp-relay.brevo.com, port 587)
DEFAULT_FROM_EMAIL=Tourchef <buchungen@example.ch>
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true

# Guest replies to guide messages (future_dev/messenger.md). Empty = replies go to the guide's own address.
# Mailgun route: match_recipient("antwort\+.*@<REPLY_EMAIL_DOMAIN>") -> forward("<SITE_URL>/eingang/mail/")
REPLY_EMAIL_DOMAIN=
REPLY_EMAIL_LOCAL=antwort
MAILGUN_WEBHOOK_SIGNING_KEY=

# Stripe TEST mode keys (sk_test_...). Webhook: <SITE_URL>/zahlungen/stripe/webhook/
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CONNECT_WEBHOOK_SECRET=
PLATFORM_FEE_PERCENT=0
# Card and TWINT only (no bank transfer). Remove twint if Stripe can't offer it.
STRIPE_PAYMENT_METHODS=card,twint

REQUEST_RESPONSE_DAYS=5
GUEST_RESPONSE_DAYS=5

# --- Data protection (12-datenschutz.md) ---
# Encrypts guest phone, emergency contact and experience. Comma-separated, newest first (rotation).
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Losing it makes these fields unreadable: keep a copy in a password manager.
FIELD_ENCRYPTION_KEYS=
# Two-factor login for guides (staff always). Keep true in production.
REQUIRE_GUIDE_2FA=true
# Shown in the legal notice and privacy policy
OPERATOR_NAME=
OPERATOR_ADDRESS=
PRIVACY_EMAIL=
