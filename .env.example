# Copy to .env and fill in. Never commit .env.

# --- Django ---
# Generate: python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=
DEBUG=false
SITE_URL=https://buchen.example.ch
ALLOWED_HOSTS=buchen.example.ch
# Number of reverse proxies in front of the app (for correct client IPs in rate limiting)
NUM_PROXIES=1
# Change to something hard to guess
ADMIN_URL=verwaltung-xyz/
# Guides need this code to register. Empty = registration closed.
GUIDE_SIGNUP_CODE=
# Comma-separated; receive alerts about payment problems
ADMIN_EMAILS=

# --- Database (used by compose.yml) ---
POSTGRES_DB=tourchef
POSTGRES_USER=tourchef
POSTGRES_PASSWORD=
# For running outside Docker:
# DATABASE_URL=postgres://tourchef:<password>@localhost:5432/tourchef

# --- Email (SMTP). Empty EMAIL_HOST = print emails to the console ---
DEFAULT_FROM_EMAIL=Tourchef <buchungen@example.ch>
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true

# --- Stripe Connect (https://dashboard.stripe.com/apikeys) ---
STRIPE_SECRET_KEY=
# Webhook endpoint: <SITE_URL>/zahlungen/stripe/webhook/
#   "Your account" events: checkout.session.completed, checkout.session.async_payment_succeeded,
#   checkout.session.expired, checkout.session.async_payment_failed
STRIPE_WEBHOOK_SECRET=
#   "Connected accounts" events: account.updated
STRIPE_CONNECT_WEBHOOK_SECRET=
PLATFORM_FEE_PERCENT=0
# Card and TWINT only (no bank transfer). Remove twint if Stripe can't offer it.
STRIPE_PAYMENT_METHODS=card,twint

# --- Booking rules ---
REQUEST_RESPONSE_DAYS=5
GUEST_RESPONSE_DAYS=5
SCHEDULER_INTERVAL_SECONDS=3600

# --- Data protection (12-datenschutz.md) ---
# Encrypts guest phone, emergency contact and experience. Comma-separated, newest first (rotation).
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Losing it makes these fields unreadable: keep a copy in a password manager.
FIELD_ENCRYPTION_KEYS=
# Two-factor login for guides (staff always). Keep true in production.
REQUIRE_GUIDE_2FA=true
# Shown in the legal notice and privacy policy
OPERATOR_NAME=
OPERATOR_ADDRESS=
PRIVACY_EMAIL=
