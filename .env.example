# Copy this file to .env and fill in your real values.
# .env is gitignored — NEVER commit it to version control.
# On production servers, set these as environment variables in your hosting dashboard.

MYSQL_DATABASE=bergfuehrer_db
MYSQL_ROOT_PASSWORD=change_me_strong_password
MYSQL_USER=tourchef_app
MYSQL_PASSWORD=change_me_strong_password

# Email — ProtonMail App Password: https://account.proton.me/u/0/security
MAIL_USERNAME=you@protonmail.ch
MAIL_PASSWORD=your-app-password-here
MAIL_FROM=you@protonmail.ch
MAIL_SERVER=smtp.protonmail.ch
MAIL_PORT=587

# Stripe — https://dashboard.stripe.com/apikeys
# sk_test_... for dev, sk_live_... for production
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Public URL (update when deploying)
APP_BASE_URL=http://localhost:8000
